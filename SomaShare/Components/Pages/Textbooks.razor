@page "/textbooks"
@rendermode InteractiveServer
@using SomaShare.Models
@using SomaShare.Data
@inject ApplicationDbContext db
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Buyer,Seller,Admin")]
@inject IJSRuntime JS

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Available Textbooks</h3>

   

    <NavLink href="/create-textbook" class="btn btn-success">
        - Sell Textbook
    </NavLink>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success">
        @message
    </div>
}

<div class="mb-3">
    <input placeholder="Search title/author/module" @bind="searchText" class="form-control" />

    <br />

    <input type="number" @bind="minPrice" placeholder="Min Price" class="form-control" />
    <input type="number" @bind="maxPrice" placeholder="Max Price" class="form-control" />

    <br />

    <select @bind="selectedCondition" class="form-control">
        <option value="">All Conditions</option>
        <option value="New">New</option>
        <option value="Good">Good</option>
        <option value="Fair">Fair</option>
    </select>

    <br />

    <button type="button" class="btn btn-primary" @onclick="ApplyFilter">
        Search
    </button>
</div>

@if (textbooks == null)
{
    <p>Loading...</p>
}
else if (!textbooks.Any())
{
    <p>No textbooks available yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Module</th>
                <th>Condition</th>
                <th>Price</th>
                <th>Trust Score</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in textbooks)
            {
                <tr>
                    <td>@t.Title</td>
                    <td>@t.Author</td>
                    <td>@t.Module</td>
                    <td>@t.Condition</td>
                    <td>R @t.Price</td>

                    <td>
                        @{
                            var trust = db.Reviews
                                .Where(r => r.ReviewedUserID == t.UserID)
                                .Average(r => (int?)r.Rating) ?? 0;
                        }
                        @trust
                    </td>

                    <td>
                        <a href="/edit-textbook/@t.TextbookID">Edit</a>

                        <button @onclick="() => ConfirmDelete(t.TextbookID)">
                            Delete
                        </button>

                        <a href="/make-offer/@t.TextbookID">Make Offer</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-primary"
            @onclick="PrevPage"
            disabled="@(page == 1)">
        Previous
</button>

<button class="btn btn-primary" @onclick="NextPage" disabled="@(page * pageSize >= totalItems)">
    Next
</button>
}

@code {
    private List<Textbook> textbooks = new();

    private string searchText = "";
    private decimal? minPrice;
    private decimal? maxPrice;
    private string message = "";

    private string selectedCondition = "";

    private int page = 1;
    private int pageSize = 10;
    private int totalItems;

    private void LoadData()
    {
        var query = db.Textbooks.AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            query = query.Where(t =>
            t.Title.Contains(searchText) ||
            t.Author.Contains(searchText) ||
            t.Module.Contains(searchText));
        }

        if (minPrice.HasValue)
        {
            query = query.Where(t => t.Price >= minPrice.Value);
        }

        if (maxPrice.HasValue)
        {
            query = query.Where(t => t.Price <= maxPrice.Value);
        }

        if (!string.IsNullOrWhiteSpace(selectedCondition))
        {
            query = query.Where(t => t.Condition == selectedCondition);
        }

        totalItems = query.Count();

        textbooks = query
        .Skip((page - 1) * pageSize)
        .Take(pageSize)
        .ToList();
    }

    protected override void OnInitialized()
    {
        LoadData();
    }

    private async Task DeleteTextbook(int id)
    {
        var textbook = db.Textbooks.FirstOrDefault(t => t.TextbookID == id);

        if (textbook != null)
        {
            db.Textbooks.Remove(textbook);
            await db.SaveChangesAsync();
            LoadData();
        }
    }

    private async Task ConfirmDelete(int id)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this textbook?");
        if (confirm)
        {
            await DeleteTextbook(id);
            message = "Textbook deleted successfully!";
        }
    }

    private void ApplyFilter()
    {
        Console.WriteLine($"Min: {minPrice}, Max: {maxPrice}");
        page = 1;
        LoadData();
    }

    private void NextPage()
    {
        if (page * pageSize < totalItems)
        {
            page++;
            LoadData();
        }

    }

    private void PrevPage()
    {
        if (page > 1)
            page--;
        LoadData();
    }
}
